config_version=5

[application]
config/name="ARROW FLOW: Escape Puzzle"
config/icon="res://ui/android_icon.svg"
run/main_scene="res://scenes/app.tscn"

[display]
window/handheld/orientation=1
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.062745, 0.113725, 0.152941, 1)
